+          let MultiLineStr =
+            " ST_GeographyFromText('SRID=4326;MULTILINESTRING(";
+          for (let i = 0; i < geoms.length - 1; i++) {
+            let GeojsonObj = JSON.parse(geoms[i].st_asgeojson);
+            MultiLineStr += "(";
